<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DirectXTexNet" Version="1.0.7" />
    <PackageReference Include="GBX.NET" Version="2.1.1" />
    <PackageReference Include="GBX.NET.LZO" Version="2.1.2" />
    <PackageReference Include="GBX.NET.ZLib" Version="1.1.1" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.2" />
    <PackageReference Include="Unofficial.LibTessDotNet" Version="2.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Blocks\" />
  </ItemGroup>

</Project>
