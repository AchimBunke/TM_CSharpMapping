<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

    <PackageId>TM_CSharpMapping</PackageId>
    <Version>0.2.15</Version>
    <Authors>Achim Bunke</Authors>
    <Description>CSharp library for Trackmania map and MediaTracker editing.</Description>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
    <PackageOutputPath>$(OutputPath)</PackageOutputPath>
    
  </PropertyGroup>


  <ItemGroup>
    <PackageReference Include="AssimpNet" Version="4.1.0" />
    <PackageReference Include="DirectXTexNet" Version="1.0.7" />
    <PackageReference Include="Earcut.NET" Version="1.2.0" />
    <PackageReference Include="GBX.NET" Version="2.4.4" />
    <PackageReference Include="GBX.NET.LZO" Version="2.1.6" />
    <PackageReference Include="GBX.NET.ZLib" Version="1.1.2" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.2" />
    <PackageReference Include="Unofficial.LibTessDotNet" Version="2.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Blocks\" />
  </ItemGroup>
  
  <ItemGroup>
    <EmbeddedResource Include="Templates\*.Gbx" />
  </ItemGroup>
  
  <ItemGroup>
    <EmbeddedResource Include="Templates\icons-24.png" />
  </ItemGroup>

  <ItemGroup>
    <None Include="LICENSE" Pack="true" PackagePath="\" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Templates\TriggerItemTemplate.Item.Gbx">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>

</Project>
